# Database Configuration
# Format: postgresql://user:password@host:port/database
DATABASE_URL="postgresql://user:password@localhost:5432/rxsaas"

# NextAuth Configuration
# Gere uma chave segura: openssl rand -base64 32
NEXTAUTH_SECRET="sua_chave_secreta_aqui"

# Application URL
# Em desenvolvimento: http://localhost:3000
# Em produção: seu_dominio_aqui
NEXTAUTH_URL="http://localhost:3000"

# Node Environment
NODE_ENV="development"

# Evolution API (notificação de novos pedidos via WhatsApp — hook para uso futuro)
EVOLUTION_API_URL="https://sua-instancia-evolution.exemplo.com"
EVOLUTION_API_KEY="sua_chave_de_api_aqui"
EVOLUTION_INSTANCE_NAME="nome_da_instancia"

# Número de WhatsApp da loja (usado no link "Enviar pedido no WhatsApp" do checkout)
NEXT_PUBLIC_STORE_WHATSAPP_NUMBER="5511999999999"
