generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ USUÁRIOS ============
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  type      UserType

  // Restaurante que gerencia
  ownedRestaurant Restaurant? @relation("RestaurantOwner")

  // Pedidos que fez
  orders    Order[]

  // Produtos favoritos
  favoriteProducts FavoriteProduct[] @relation("FavoriteProducts")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
}

enum UserType {
  ADMIN     // Dono/gerente do restaurante
  CUSTOMER  // Cliente/consumidor
}

// ============ RESTAURANTE ============
model Restaurant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  email       String?
  phone       String?

  // Dono do restaurante
  ownerId     String   @unique
  owner       User     @relation("RestaurantOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  // Conteúdo do restaurante
  categories  Category[]
  products    Product[]
  orders      Order[]
  promotions  Promotion[] @relation("Promotions")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId])
}

// ============ CATEGORIA DO CARDÁPIO ============
model Category {
  id          String   @id @default(cuid())
  name        String
  description String?
  image       String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  products    Product[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([restaurantId])
  @@unique([restaurantId, name])
}

// ============ PRODUTO ============
model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  image       String?

  // Informações nutricionais e alérgenos
  nutritionInfo String?
  allergens    String? // JSON array de alérgenos
  ingredients  String? // JSON array de ingredientes

  // Status e disponibilidade
  isActive    Boolean  @default(true)
  isAvailable Boolean  @default(true)
  isFeatured  Boolean  @default(false)

  // Mais vendidos - contador de vendas
  salesCount  Int      @default(0)

  // Controle de horário e dias
  availableFrom String? // HH:MM
  availableTo   String? // HH:MM
  availableDays String? // JSON array de dias (0-6, seg-dom)

  // Tipo de produto
  productType ProductType @default(REGULAR)

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  // Relações
  optionGroups ProductOptionGroup[]
  orderItems   OrderItem[]
  favoritedBy  FavoriteProduct[] @relation("FavoritedBy")

  order       Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([restaurantId])
  @@index([categoryId])
  @@index([isActive])
  @@index([isFeatured])
}

enum ProductType {
  REGULAR     // Produto comum
  COMBO       // Combo de produtos
  KIT         // Kit de produtos
  SEASONAL    // Produto sazonal
}

// ============ GRUPO DE OPCIONAIS ============
model ProductOptionGroup {
  id          String   @id @default(cuid())
  name        String
  type        OptionGroupType
  description String?

  // Configuração
  isRequired  Boolean  @default(false)
  minSelect   Int      @default(0)
  maxSelect   Int?     // null = sem limite
  allowMultiple Boolean @default(false)

  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  options     ProductOption[]
  order       Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId])
}

enum OptionGroupType {
  SIZE        // Tamanhos
  FLAVOR      // Sabores
  ADDITIONAL  // Adicionais
  REMOVAL     // Remoções
  CUSTOM      // Personalizado
}

// ============ OPÇÕES DE PRODUTO ============
model ProductOption {
  id          String   @id @default(cuid())
  name        String
  price       Decimal  @default(0) @db.Decimal(10, 2)
  isActive    Boolean  @default(true)

  groupId     String
  group       ProductOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  orderModifiers OrderItemModifier[]

  order       Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([groupId])
}

// ============ FAVORITOS (MÓDULO 1: Cardápio Digital - Cliente) ============
model FavoriteProduct {
  id        String   @id @default(cuid())

  customerId String
  customer   User     @relation("FavoriteProducts", fields: [customerId], references: [id], onDelete: Cascade)

  productId  String
  product    Product  @relation("FavoritedBy", fields: [productId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
  @@index([customerId])
  @@index([productId])
}

// ============ PROMOÇÕES (MÓDULO 1: Cardápio Digital - Admin) ============
model Promotion {
  id          String   @id @default(cuid())
  code        String   @unique
  description String?

  // Desconto
  discountType DiscountType
  discountValue Decimal @db.Decimal(10, 2)

  // Limitações
  minOrderValue Decimal? @db.Decimal(10, 2)
  maxUses      Int?
  usedCount    Int     @default(0)

  // Período de validade
  startsAt    DateTime
  endsAt      DateTime

  // Restrições por produto
  applicableProducts String? // JSON array de product IDs

  restaurantId String
  restaurant  Restaurant @relation("Promotions", fields: [restaurantId], references: [id], onDelete: Cascade)

  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([restaurantId])
  @@index([isActive])
  @@index([code])
}

enum DiscountType {
  PERCENTAGE  // Percentual
  FIXED       // Valor fixo
}

// ============ PEDIDOS (MÓDULO 3: Pedidos) ============
model Order {
  id          String   @id @default(cuid())
  orderNumber String   @unique

  status      OrderStatus @default(PENDING)
  orderType   OrderType   @default(PICKUP) // PICKUP, DELIVERY, DINE_IN
  separationType SeparationType? // Separar para balcão, delivery ou mesa

  restaurantId String
  restaurant  Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  customerId  String
  customer    User @relation(fields: [customerId], references: [id], onDelete: SetNull)

  items       OrderItem[]

  // Valores
  subtotal    Decimal  @db.Decimal(10, 2)
  tax         Decimal  @default(0) @db.Decimal(10, 2)
  discount    Decimal  @default(0) @db.Decimal(10, 2)
  tip         Decimal  @default(0) @db.Decimal(10, 2)
  total       Decimal  @db.Decimal(10, 2)

  // Cupom e promoção
  couponCode  String?

  // Agendamento e observações
  scheduledFor DateTime? // Quando o cliente quer receber
  notes       String?
  prepTime    Int? // Tempo estimado de preparo em minutos

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  completedAt DateTime?

  @@index([restaurantId])
  @@index([customerId])
  @@index([status])
  @@index([orderType])
  @@index([scheduledFor])
}

enum OrderStatus {
  PENDING       // Aguardando confirmação
  CONFIRMED     // Confirmado
  PREPARING     // Em preparação
  READY         // Pronto
  COMPLETED     // Completo
  CANCELLED     // Cancelado
}

enum OrderType {
  PICKUP      // Retirar no balcão
  DELIVERY    // Entrega
  DINE_IN     // Comer no local
}

enum SeparationType {
  COUNTER     // Separar para balcão
  DELIVERY    // Separar para delivery
  TABLE       // Separar para mesa
}

// ============ ITENS DO PEDIDO ============
model OrderItem {
  id        String   @id @default(cuid())
  quantity  Int      @default(1)

  orderId   String
  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  // Preço do item no momento do pedido
  unitPrice Decimal @db.Decimal(10, 2)

  // Modificadores do item
  modifiers OrderItemModifier[]

  // Notas especiais do item
  notes     String?

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

// ============ MODIFICADORES DO ITEM DO PEDIDO ============
model OrderItemModifier {
  id        String   @id @default(cuid())

  itemId    String
  item      OrderItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  optionId  String
  option    ProductOption @relation(fields: [optionId], references: [id], onDelete: Restrict)

  quantity  Int      @default(1)
  price     Decimal  @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@index([itemId])
  @@index([optionId])
}
